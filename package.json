{
  "name": "finance-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal retirement planner: deterministic, historical, and Monte Carlo projections with real US federal + state tax math.",
  "scripts": {
    "start": "npm run build:ui && tsx src/server/server.ts",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build:ui && FPLAN_NO_OPEN=1 tsx src/server/server.ts",
    "dev:api": "FPLAN_NO_OPEN=1 tsx watch src/server/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
